{
  "machine_name": "cloud-node-b",
  "install_root": "/opt/ddb",
  "local_ip": "<node-b-private-ip>",
  "etcd_host": "<control-private-ip>",
  "etcd_port": 2379,
  "data_root": "/opt/ddb/data",
  "log_dir": "/opt/ddb/logs/node-b",
  "state_dir": "/opt/ddb/state",
  "server_binary": "/opt/ddb/bin/ddb-server",
  "build_server_binary": false,
  "targets": [
    {
      "name": "g1-n2",
      "runner": "ddb-process",
      "role": "shard",
      "group_id": "g1",
      "http_port": 21180,
      "raft_port": 22180,
      "bootstrap": false
    },
    {
      "name": "g2-n2",
      "runner": "ddb-process",
      "role": "shard",
      "group_id": "g2",
      "http_port": 21181,
      "raft_port": 22181,
      "bootstrap": false
    },
    {
      "name": "g3-n2",
      "runner": "ddb-process",
      "role": "shard",
      "group_id": "g3",
      "http_port": 21182,
      "raft_port": 22182,
      "bootstrap": false
    },
    {
      "name": "g3-n4",
      "runner": "ddb-process",
      "role": "shard",
      "group_id": "g3",
      "http_port": 21382,
      "raft_port": 22382,
      "bootstrap": false
    },
    {
      "name": "g1-n5",
      "runner": "ddb-process",
      "role": "shard",
      "group_id": "g1",
      "http_port": 21480,
      "raft_port": 22480,
      "bootstrap": false
    }
  ]
}
